<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>FastEnumUtility.Benchmarks</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" />
        <PackageReference Include="Enums.NET" />
        <PackageReference Include="NetEscapades.EnumGenerators" />
    </ItemGroup>

    <!--
        FastEnumLibs is the directory of FastEnum.Core / FastEnum.Generators to benchmark; this source tree by default.
        BenchmarkConfig.ForComparison() sets it for the baseline job to another tree (e.g. a worktree of the previous release),
        so that both versions are measured in one run.
    -->
    <PropertyGroup>
        <FastEnumLibs Condition="'$(FastEnumLibs)' == ''">$(MSBuildThisFileDirectory)..\..\libs</FastEnumLibs>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(FastEnumLibs)\FastEnum.Core\FastEnum.Core.csproj" />
        <ProjectReference Include="$(FastEnumLibs)\FastEnum.Generators\FastEnum.Generators.csproj">
            <OutputItemType>Analyzer</OutputItemType>
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        </ProjectReference>
    </ItemGroup>

</Project>
